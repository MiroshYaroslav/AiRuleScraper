# Example configuration file.
# Copy this file, rename it to .env, and insert your real credentials.
# IMPORTANT: Never commit the .env file to version control!

# PostgreSQL database connection (using asyncpg)
DATABASE_URL=postgresql+asyncpg://your_user:your_password@localhost:5432/your_database_name

# API keys for Groq (Model for rule extraction)
# You can specify a single key or multiple keys separated by commas for load balancing (Sticky Failover)
GROQ_API_KEYS=gsk_example_key_1,gsk_example_key_2,gsk_example_key_3

# API keys for Google Gemini (Model for generating vector embeddings)
# Multiple keys separated by commas are also supported here
GEMINI_API_KEYS=AIzaSy_example_key_1,AIzaSy_example_key_2
